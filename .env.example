# Gemini AI Configuration (Free API key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Owner's phone number with country code without + or spaces (e.g. 919876543210)
# Allows the owner to run owner-only commands from another device/number
OWNER_NUMBER=

# Check intervals in minutes (default: 30)
CHECK_INTERVAL_MINUTES=30
